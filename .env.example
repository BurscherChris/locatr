APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
NEURON_BASE_URL=https://neuron.noser.com/v1
NEURON_API_KEY=
NEURON_MODEL=gpt-4.1
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
LINEAR_API_URL=https://api.linear.app/graphql
AGENT_MAX_ITERATIONS=50
WORKSPACE_ROOT=/workspaces
COMMAND_TIMEOUT_SECONDS=120
HTTP_TIMEOUT_SECONDS=60
AGENT_GIT_NAME=Neuron Coding Agent
AGENT_GIT_EMAIL=neuron-agent@localhost
COMMAND_ALLOWLIST=pytest,npm,python,python3,git,node,uv,pip,poetry,make,ls,find,cat,sed,head,tail,rg
COMMAND_DENYLIST=curl,wget,ssh,scp,docker,mount,sudo,env,printenv

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=
LINEAR_OAUTH_SCOPES=read,write,app:assignable,app:mentionable
LINEAR_OAUTH_ACTOR=app
LINEAR_TOKEN_STORE_PATH=/data/linear_tokens.json

# Repository to operate on when the webhook payload does not include one
GITHUB_REPO=

# Slack integration (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TICKET_PROPOSAL_STORE_PATH=/data/slack_proposals.json
